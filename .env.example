# Copy to .env and replace the password. .env is ignored by git.

# PostgreSQL container (compose.yaml)
POSTGRES_USER=pathofflipper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pathofflipper
POSTGRES_PORT=5432

# Connection strings used by the scripts; keep them in sync with the values above.
DATABASE_URL=postgres://pathofflipper:change-me@localhost:5432/pathofflipper
TEST_DATABASE_URL=postgres://pathofflipper:change-me@localhost:5432/pathofflipper_test

# Contact sent in the User-Agent header, as the PoE developer guidelines require (email or URL).
POE_USER_AGENT_CONTACT=https://github.com/stdmitry/pathofflipper

# Fetch defaults; command-line options override them.
# Only pc (PoE 1 PC) is supported; any other realm is rejected.
POE_REALM=pc
POE_MAX_HOURS=24
